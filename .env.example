APP_NAME=Ageless
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=Asia/Kolkata
APP_URL=https://agelessindia.in

ADMIN_EMAIL=
ADMIN_PASSWORD=

LOG_CHANNEL=stack
LOG_LEVEL=error

# Local XAMPP: DB_HOST=127.0.0.1, DB_USERNAME=root, empty password.
# Hostinger: use the database name, user and password from hPanel (they start with u326778858_).
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

CACHE_STORE=file
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=public

# Chatbot: "ollama" works only on a PC running Ollama (see docs/ollama-chat.md).
# On the live site use "huggingface" with a token (see docs/huggingface-chat.md).
# Create a token with "Make calls to Inference Providers" permission.
CHAT_PROVIDER=huggingface
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=
OLLAMA_TIMEOUT=120
HF_TOKEN=
HF_MODEL=openai/gpt-oss-120b:cheapest

# Enquiry emails (contact form) are sent through EmailJS to ENQUIRY_MAIL_TO.
ENQUIRY_MAIL_TO=sales@agelessind.com
EMAILJS_SERVICE_ID=
EMAILJS_TEMPLATE_ID=
EMAILJS_PUBLIC_KEY=
EMAILJS_PRIVATE_KEY=
