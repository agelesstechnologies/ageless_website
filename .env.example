APP_NAME=Ageless
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Asia/Kolkata
APP_URL=http://localhost:8000

ADMIN_EMAIL=admin@ageless.com
ADMIN_PASSWORD=P@ssw0rd

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_DATABASE=database/database.sqlite

# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=ageless_db
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

CACHE_STORE=file
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=public

# Local Ollama chatbot; see docs/ollama-chat.md.
CHAT_PROVIDER=ollama
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=hf.co/braydenh563/Qwen3.6-35B-Uncensored-HauhauCS-1M-MTP-Ollama:Q4_K_M
OLLAMA_TIMEOUT=120

# Optional hosted provider: set CHAT_PROVIDER=huggingface.
# Create a token with "Make calls to Inference Providers" permission.
# Hosted inference has limited free credits; see docs/huggingface-chat.md.
HF_TOKEN=
HF_MODEL=openai/gpt-oss-120b:cheapest
